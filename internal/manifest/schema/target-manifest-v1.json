{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/go-agent-optimizer/target-manifest-v1.schema.json",
  "title": "Go Agent Optimizer target manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "target", "workloads", "sandbox", "normalization", "performance", "campaign", "optimization_policy"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "version": {"const": "v1"},
    "name": {"type": "string", "minLength": 1},
    "target": {"$ref": "#/$defs/target"},
    "workloads": {"$ref": "#/$defs/workloads"},
    "sandbox": {"$ref": "#/$defs/sandbox"},
    "normalization": {"$ref": "#/$defs/normalization"},
    "performance": {"$ref": "#/$defs/performance"},
    "campaign": {"$ref": "#/$defs/campaign"},
    "optimization_policy": {"enum": ["idiomatic", "specialized", "native"]}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "build", "command"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "build": {"$ref": "#/$defs/build"},
        "command": {"type": "array", "items": {"type": "string"}}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "binary"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "binary": {"type": "string", "minLength": 1}
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seeds", "discovery", "tiers"],
      "properties": {
        "seeds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/seed"}},
        "discovery": {"$ref": "#/$defs/discovery"},
        "tiers": {"$ref": "#/$defs/tiers"}
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tier", "args", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "tier": {"enum": ["representative", "plausible", "stress"]},
        "args": {"type": "array", "items": {"type": "string"}},
        "stdin": {"type": "string"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "provenance": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "timeout": {"type": "string", "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "content": {"type": "string"}
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "sources", "strategies", "seed", "max_cases", "max_depth"],
      "properties": {
        "enabled": {"type": "boolean"},
        "sources": {"type": "array", "items": {"type": "string"}},
        "strategies": {"type": "array", "items": {"type": "string"}},
        "seed": {"type": "integer", "minimum": 0},
        "max_cases": {"type": "integer", "minimum": 1},
        "max_depth": {"type": "integer", "minimum": 1}
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representative", "plausible", "stress"],
      "properties": {
        "representative": {"$ref": "#/$defs/tier"},
        "plausible": {"$ref": "#/$defs/tier"},
        "stress": {"$ref": "#/$defs/tier"}
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "acceptance_eligible"],
      "properties": {
        "weight": {"type": "number", "minimum": 0},
        "acceptance_eligible": {"type": "boolean"}
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "filesystem", "environment", "max_processes"],
      "properties": {
        "network": {"enum": ["deny", "allow"]},
        "filesystem": {"$ref": "#/$defs/filesystem"},
        "environment": {"$ref": "#/$defs/environment"},
        "max_processes": {"type": "integer", "minimum": 1},
        "max_memory_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read": {"enum": ["repo_and_assets", "manifest_paths", "none"]},
        "write": {"enum": ["temp_only", "manifest_paths", "any"]}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "passthrough"],
      "properties": {
        "allow": {"type": "array", "items": {"type": "string"}},
        "passthrough": {"type": "array", "items": {"type": "string"}}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr", "files"],
      "properties": {
        "stdout": {"$ref": "#/$defs/stream-normalization"},
        "stderr": {"$ref": "#/$defs/stream-normalization"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/file-normalization"}}
      }
    },
    "stream-normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["exact", "trim_trailing_whitespace", "lines_sorted", "json", "ignore"]},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
      }
    },
    "file-normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "mode": {"enum": ["exact", "trim_trailing_whitespace", "lines_sorted", "json", "ignore"]},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pattern", "replacement"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "pattern": {"type": "string", "minLength": 1},
        "replacement": {"type": "string"}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "primary_metric": {"type": "string", "minLength": 1},
        "minimum_improvement_percent": {"type": "number", "minimum": 0},
        "maximum_guardrail_regression_percent": {"type": "number", "minimum": 0},
        "statistical_support_required": {"type": "boolean"},
        "guardrails": {"type": "array", "items": {"$ref": "#/$defs/guardrail"}}
      }
    },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "maximum_regression_percent": {"type": "number", "minimum": 0},
        "required": {"type": "boolean"}
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "max_duration": {"type": "string", "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$"},
        "max_candidate_patches": {"type": "integer", "minimum": 1},
        "max_concurrent_candidates": {"const": 1},
        "stop_after_failures": {"type": "integer", "minimum": 1},
        "discovery_stall_timeout": {"type": "string", "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$"},
        "per_command_timeout_multiple": {"type": "number", "exclusiveMinimum": 0},
        "minimum_command_timeout": {"type": "string", "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$"}
      }
    }
  }
}
