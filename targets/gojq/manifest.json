{
  "$schema": "https://example.com/go-agent-optimizer/target-manifest-v1.schema.json",
  "version": "v1",
  "name": "gojq CLI",
  "target": {
    "repository": "https://github.com/itchyny/gojq",
    "build": {
      "package": "./cmd/gojq",
      "binary": "gojq"
    },
    "command": []
  },
  "workloads": {
    "seeds": [
      {
        "id": "select-fields",
        "name": "Select fields from a JSON array",
        "tier": "representative",
        "args": [".users[] | {name, active}"],
        "stdin": "{\"users\":[{\"name\":\"Ada\",\"active\":true},{\"name\":\"Grace\",\"active\":false}]}\n",
        "provenance": "manifest",
        "description": "Small deterministic query representative of common filtering and projection use."
      },
      {
        "id": "map-values",
        "name": "Map numeric values",
        "tier": "representative",
        "args": ["map(.price * .quantity)"],
        "stdin": "[{\"price\":3,\"quantity\":2},{\"price\":5,\"quantity\":4}]\n",
        "provenance": "manifest",
        "description": "Exercises repeated array traversal and numeric evaluation."
      },
      {
        "id": "nested-transform",
        "name": "Transform nested documents",
        "tier": "plausible",
        "args": [".orders[] | {id, total: ([.items[].amount] | add)}"],
        "stdin": "{\"orders\":[{\"id\":1,\"items\":[{\"amount\":2},{\"amount\":4}]},{\"id\":2,\"items\":[{\"amount\":7}]}]}\n",
        "provenance": "inferred-from-json-query-semantics",
        "description": "Generated-style nested array reduction for discovery and scaling analysis."
      },
      {
        "id": "large-array",
        "name": "Large array traversal",
        "tier": "stress",
        "args": ["map(.value) | add"],
        "stdin": "[{\"value\":1},{\"value\":2},{\"value\":3},{\"value\":4},{\"value\":5}]\n",
        "provenance": "adversarial-size-sweep-seed",
        "description": "Seed for deterministic expansion to large generated arrays; stress evidence cannot accept a patch alone."
      }
    ],
    "discovery": {
      "enabled": true,
      "sources": ["help", "documentation", "examples", "tests", "benchmarks", "seed_mutation"],
      "strategies": ["query_mutation", "json_shape_generation", "input_size_sweep", "boundary_values", "coverage_guided"],
      "seed": 20260821,
      "max_cases": 200,
      "max_depth": 4
    },
    "tiers": {
      "representative": {"weight": 1.0, "acceptance_eligible": true},
      "plausible": {"weight": 0.5, "acceptance_eligible": false},
      "stress": {"weight": 0.0, "acceptance_eligible": false}
    }
  },
  "sandbox": {
    "network": "deny",
    "filesystem": {"read": "repo_and_assets", "write": "temp_only"},
    "environment": {"allow": ["LANG", "LC_ALL"], "passthrough": []},
    "max_processes": 1,
    "max_memory_bytes": 1073741824
  },
  "normalization": {
    "stdout": {"mode": "exact"},
    "stderr": {"mode": "exact"},
    "files": []
  },
  "performance": {
    "primary_metric": "wall_time_ns",
    "minimum_improvement_percent": 3.0,
    "maximum_guardrail_regression_percent": 2.0,
    "statistical_support_required": true,
    "guardrails": [
      {"name": "peak_memory_bytes", "maximum_regression_percent": 2.0, "required": true},
      {"name": "cpu_time_ns", "maximum_regression_percent": 2.0, "required": true},
      {"name": "binary_size_bytes", "maximum_regression_percent": 2.0, "required": true}
    ]
  },
  "campaign": {
    "max_duration": "90m",
    "max_candidate_patches": 12,
    "max_concurrent_candidates": 1,
    "stop_after_failures": 4,
    "discovery_stall_timeout": "20m",
    "per_command_timeout_multiple": 2.0,
    "minimum_command_timeout": "30s"
  },
  "optimization_policy": "idiomatic"
}
