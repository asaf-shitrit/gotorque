{
  "$schema": "https://example.com/gotorque/target-manifest-v1.schema.json",
  "version": "v1",
  "name": "tomljson CLI",
  "target": {
    "repository": "https://github.com/pelletier/go-toml",
    "build": {
      "package": "./cmd/tomljson",
      "binary": "tomljson"
    },
    "command": []
  },
  "workloads": {
    "seeds": [
      {
        "id": "convert-generated-toml",
        "name": "Convert a 14000-table generated TOML file to JSON",
        "tier": "representative",
        "args": [
          "config.toml"
        ],
        "files": [
          {
            "path": "config.toml",
            "content": "[[servers]]\nname = \"srv0\"\nip = \"10.0.0.0\"\nport = 8080\ntags = [\"prod\", \"web\"]\n\n  [servers.limits]\n  cpu = 2\n  memory = 512\n\n",
            "repeat": 14000
          }
        ],
        "provenance": "manifest",
        "description": "toml.Decoder over repeated [[servers]] array-of-tables entries, then json.Encoder with two-space indent."
      },
      {
        "id": "convert-generated-toml-stdin",
        "name": "Convert a 7000-table generated TOML file via stdin",
        "tier": "representative",
        "args": [],
        "stdin_header": "",
        "stdin": "[[servers]]\nname = \"srv0\"\nip = \"10.0.0.0\"\nport = 8080\ntags = [\"prod\", \"web\"]\n\n  [servers.limits]\n  cpu = 2\n  memory = 512\n\n",
        "stdin_repeat": 7000,
        "provenance": "manifest",
        "description": "same decode/encode path, reached through stdin instead of a filename argument."
      },
      {
        "id": "convert-small-toml",
        "name": "Convert a 200-table generated TOML file",
        "tier": "plausible",
        "args": [
          "small.toml"
        ],
        "files": [
          {
            "path": "small.toml",
            "content": "[[servers]]\nname = \"srv0\"\nip = \"10.0.0.0\"\nport = 8080\ntags = [\"prod\", \"web\"]\n\n  [servers.limits]\n  cpu = 2\n  memory = 512\n\n",
            "repeat": 200
          }
        ],
        "provenance": "manifest"
      },
      {
        "id": "convert-generated-toml-large",
        "name": "Convert a 1.6M-table generated TOML file to JSON",
        "tier": "stress",
        "args": [
          "huge.toml"
        ],
        "files": [
          {
            "path": "huge.toml",
            "content": "[[servers]]\nname = \"srv0\"\nip = \"10.0.0.0\"\nport = 8080\ntags = [\"prod\", \"web\"]\n\n  [servers.limits]\n  cpu = 2\n  memory = 512\n\n",
            "repeat": 1600000
          }
        ],
        "provenance": "manifest",
        "description": "~197MB expanded input; observed 4-6s wall time locally (noisy machine), within the macOS sampler's target band."
      }
    ],
    "discovery": {
      "enabled": true,
      "sources": [
        "help",
        "examples"
      ],
      "strategies": [
        "input_mutation",
        "input_size_sweep"
      ],
      "seed": 20260928,
      "max_cases": 200,
      "max_depth": 4
    },
    "tiers": {
      "representative": {
        "weight": 1.0,
        "acceptance_eligible": true
      },
      "plausible": {
        "weight": 0.5,
        "acceptance_eligible": false
      },
      "stress": {
        "weight": 0.0,
        "acceptance_eligible": false
      }
    }
  },
  "sandbox": {
    "network": "deny",
    "filesystem": {
      "read": "repo_and_assets",
      "write": "temp_only"
    },
    "environment": {
      "allow": [
        "LANG",
        "LC_ALL"
      ],
      "passthrough": []
    },
    "max_processes": 1,
    "max_memory_bytes": 1073741824
  },
  "normalization": {
    "stdout": {
      "mode": "exact"
    },
    "stderr": {
      "mode": "exact"
    },
    "files": []
  },
  "performance": {
    "primary_metric": "wall_time_ns",
    "minimum_improvement_percent": 3.0,
    "maximum_guardrail_regression_percent": 2.0,
    "statistical_support_required": true,
    "guardrails": [
      {
        "name": "peak_memory_bytes",
        "maximum_regression_percent": 2.0,
        "required": true
      },
      {
        "name": "cpu_time_ns",
        "maximum_regression_percent": 2.0,
        "required": true
      },
      {
        "name": "binary_size_bytes",
        "maximum_regression_percent": 5.0,
        "required": false
      }
    ]
  },
  "campaign": {
    "max_duration": "90m",
    "max_candidate_patches": 12,
    "max_concurrent_candidates": 1,
    "stop_after_failures": 4,
    "discovery_stall_timeout": "20m",
    "per_command_timeout_multiple": 2.0,
    "minimum_command_timeout": "30s"
  },
  "optimization_policy": "idiomatic"
}
