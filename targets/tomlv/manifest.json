{
  "$schema": "https://example.com/gotorque/target-manifest-v1.schema.json",
  "version": "v1",
  "name": "tomlv CLI",
  "target": {
    "repository": "https://github.com/BurntSushi/toml",
    "build": {
      "package": "./cmd/tomlv",
      "binary": "tomlv"
    },
    "command": []
  },
  "workloads": {
    "seeds": [
      {
        "id": "validate-json",
        "name": "Parse 8000 tables and print them as JSON",
        "tier": "representative",
        "args": [
          "-json",
          "config.toml"
        ],
        "files": [
          {
            "path": "config.toml",
            "content": "[[servers]]\nname = \"srv0\"\nip = \"10.0.0.0\"\nport = 8080\ntags = [\"prod\", \"web\"]\nweight = 1.5\nenabled = true\n\n  [servers.limits]\n  cpu = 2\n  memory = 512\n\n",
            "repeat": 8000
          }
        ],
        "provenance": "manifest"
      },
      {
        "id": "validate-types",
        "name": "Parse 4000 tables and print every key's type",
        "tier": "representative",
        "args": [
          "-types",
          "config.toml"
        ],
        "files": [
          {
            "path": "config.toml",
            "content": "[[servers]]\nname = \"srv0\"\nip = \"10.0.0.0\"\nport = 8080\ntags = [\"prod\", \"web\"]\nweight = 1.5\nenabled = true\n\n  [servers.limits]\n  cpu = 2\n  memory = 512\n\n",
            "repeat": 4000
          }
        ],
        "provenance": "manifest"
      },
      {
        "id": "validate-small",
        "name": "Parse 200 tables",
        "tier": "plausible",
        "args": [
          "-json",
          "config.toml"
        ],
        "files": [
          {
            "path": "config.toml",
            "content": "[[servers]]\nname = \"srv0\"\nip = \"10.0.0.0\"\nport = 8080\ntags = [\"prod\", \"web\"]\nweight = 1.5\nenabled = true\n\n  [servers.limits]\n  cpu = 2\n  memory = 512\n\n",
            "repeat": 200
          }
        ],
        "provenance": "manifest"
      },
      {
        "id": "validate-huge",
        "name": "Parse 400000 tables",
        "tier": "stress",
        "args": [
          "-json",
          "config.toml"
        ],
        "files": [
          {
            "path": "config.toml",
            "content": "[[servers]]\nname = \"srv0\"\nip = \"10.0.0.0\"\nport = 8080\ntags = [\"prod\", \"web\"]\nweight = 1.5\nenabled = true\n\n  [servers.limits]\n  cpu = 2\n  memory = 512\n\n",
            "repeat": 60000
          }
        ],
        "provenance": "manifest"
      }
    ],
    "discovery": {
      "enabled": true,
      "sources": [
        "help",
        "examples"
      ],
      "strategies": [
        "input_mutation",
        "input_size_sweep"
      ],
      "seed": 20260928,
      "max_cases": 200,
      "max_depth": 4
    },
    "tiers": {
      "representative": {
        "weight": 1.0,
        "acceptance_eligible": true
      },
      "plausible": {
        "weight": 0.5,
        "acceptance_eligible": false
      },
      "stress": {
        "weight": 0.0,
        "acceptance_eligible": false
      }
    }
  },
  "sandbox": {
    "network": "deny",
    "filesystem": {
      "read": "repo_and_assets",
      "write": "temp_only"
    },
    "environment": {
      "allow": [
        "LANG",
        "LC_ALL"
      ],
      "passthrough": []
    },
    "max_processes": 1,
    "max_memory_bytes": 1073741824
  },
  "normalization": {
    "stdout": {
      "mode": "exact"
    },
    "stderr": {
      "mode": "exact"
    },
    "files": []
  },
  "performance": {
    "primary_metric": "wall_time_ns",
    "minimum_improvement_percent": 3.0,
    "maximum_guardrail_regression_percent": 2.0,
    "statistical_support_required": true,
    "guardrails": [
      {
        "name": "peak_memory_bytes",
        "maximum_regression_percent": 2.0,
        "required": true
      },
      {
        "name": "cpu_time_ns",
        "maximum_regression_percent": 2.0,
        "required": true
      },
      {
        "name": "binary_size_bytes",
        "maximum_regression_percent": 5.0,
        "required": false
      }
    ]
  },
  "campaign": {
    "max_duration": "90m",
    "max_candidate_patches": 12,
    "max_concurrent_candidates": 1,
    "stop_after_failures": 4,
    "discovery_stall_timeout": "20m",
    "per_command_timeout_multiple": 2.0,
    "minimum_command_timeout": "30s"
  },
  "optimization_policy": "idiomatic"
}
